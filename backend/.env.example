# SmIr Backend Configuration

# MQTT Broker
# Per MQTT_REFERENCE.md, broker is public and unauthenticated.
# For production, migrate to a private broker with credentials.
MQTT_BROKER=broker.hivemq.com
MQTT_PORT=1883
MQTT_TOPICS_CONTROL=SmIr/control
MQTT_TOPICS_NODESENSOR=SmIr/nodesensor
MQTT_TOPICS_STATUS=SmIr/status

# Command Reconciliation
# Timeout waiting for command ACK before marking "not_confirmed"
COMMAND_ACK_TIMEOUT_MS=3000
# Timeout waiting for relay status to reconcile a "not_confirmed" command
COMMAND_RECONCILE_STALE_MS=10000

# Node Configuration
# Relay nodes (1–2) have solenoids. Sensor nodes (3–4) do not.
RELAY_NODE_IDS=1,2
SENSOR_NODE_IDS=3,4

# Database
DATABASE_PATH=./smir.db

# Node Environment (affects diagnostics endpoint)
NODE_ENV=development