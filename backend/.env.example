# MQTT broker (see MQTT_DATA_REFERENCE.md — public, unauthenticated, prototype-only)
MQTT_URL=mqtt://broker.hivemq.com:1883

# Matches master firmware's COMMAND_ACK_TIMEOUT_MS (docs: 3000ms)
MQTT_ACK_TIMEOUT_MS=3000

# Matches master firmware's ONLINE_TIMEOUT_MS (docs: 20000ms) — not currently
# used server-side (the heartbeat payload already carries nodes[].online),
# kept here in case the API wants to independently recompute staleness later.
MQTT_ONLINE_TIMEOUT_MS=20000

# How long a command can sit in pending/not_confirmed before the backend
# gives up waiting for a reconciling relay status packet and marks it 'stale'.
# Docs recommend 10-15s; default here is 15000.
MQTT_RECONCILE_STALE_MS=15000

# SQLite file location
DB_PATH=./data/smir.db

# REST API port
API_PORT=3000

# Parquet archive output directory
ARCHIVE_OUT_DIR=./archive

# (Reserved — not enforced automatically anywhere yet; the archiver only runs
# when you invoke it, see script/archive-to-parquet.js)
ARCHIVE_RETENTION_DAYS=45
