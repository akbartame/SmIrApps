# .env.example
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── MQTT Broker ───────────────────────────────────────────
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=fsiot-backend

# ── Database ──────────────────────────────────────────────
DB_PATH=./data/fsiot.db

# ── API Server ────────────────────────────────────────────
API_PORT=3000
# 0.0.0.0 means listen on all interfaces. Change to any specific IP if you want to restrict access.
API_BIND_ADDR=0.0.0.0 
# API KEY for simple authentication (optional) comma separated list of valid keys
# If set, clients must include this key in the "x-api-key" header to access the API.
API_KEYS=FSIOT_API_KEY
# Optional rate limiting settings (uncomment to enable)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=100
# EXPORT_RATE_LIMIT_WINDOW_MS=3600000
# EXPORT_RATE_LIMIT_MAX_REQUESTS=10

# ── Device filtering (optional) ───────────────────────────
# Only process messages from devices whose ID starts with this prefix.
# Leave empty to accept all devices publishing under fsiot/#.
ALLOWED_DEVICE_PREFIX=FSIOT_